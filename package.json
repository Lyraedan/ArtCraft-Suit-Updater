{
  "name": "artcraft-suite-updater",
  "productName": "ArtCraft Suite Updater",
  "version": "0.1.9",
  "description": "Desktop downloader and updater for the ArtCraft Crafting Apps.",
  "license": "MIT",
  "author": "Lyraedan",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "lint": "eslint .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win portable --config.directories.output=build/github/windows",
    "dist:mac": "electron-builder --mac zip --universal --config.directories.output=build/github/mac",
    "dist:linux": "electron-builder --linux tar.gz AppImage --config.directories.output=build/github/linux"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0"
  },
  "build": {
    "appId": "com.lyraedan.artcraft-suite-updater",
    "productName": "ArtCraft Suite Updater",
    "artifactName": "ArtCraft-Suite-Updater-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "build",
      "buildResources": "build-resources"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
