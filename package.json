{
  "name": "artcraft-suite-updater",
  "productName": "ArtCraft Suite Updater",
  "version": "0.1.0",
  "description": "Desktop downloader and updater for the ArtCraft Crafting Apps.",
  "license": "MIT",
  "author": "Lyraedan",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "lint": "eslint .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0"
  },
  "build": {
    "appId": "com.lyraedan.artcraft-suite-updater",
    "productName": "ArtCraft Suite Updater",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
